<Window x:Class="UpperApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:UpperApp.UI"
        Title="小车上位机 V7.0" Height="850" Width="1500"
        MinWidth="1200" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDeepBrush}">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" MinWidth="260"/>
            <ColumnDefinition Width="*" MinWidth="400"/>
            <ColumnDefinition Width="400" MinWidth="360"/>
        </Grid.ColumnDefinitions>

        <!-- ============================================================
             左侧面板: 连接配置
             ============================================================ -->
        <Grid Grid.Column="0" Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <ui:PanelHeader Grid.Row="0" Title="连接配置" DotColor="{StaticResource AccentBlueBrush}"/>

            <!-- 连接卡片 -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0">
                <TabControl>
                    <!-- 串口 Tab -->
                    <TabItem Header="串口">
                        <StackPanel Margin="16,8,16,16">
                            <TextBlock Text="端口" Style="{StaticResource DataLabel}"/>
                            <ComboBox ItemsSource="{Binding SerialPorts}" SelectedItem="{Binding SelectedSerialPort, Mode=TwoWay}" IsEnabled="{Binding IsSerialConfigEnabled}" Margin="0,0,0,16"/>

                            <TextBlock Text="波特率" Style="{StaticResource DataLabel}"/>
                            <ComboBox ItemsSource="{Binding BaudRates}" SelectedItem="{Binding SelectedBaudRate, Mode=TwoWay}" IsEditable="True" IsEnabled="{Binding IsSerialConfigEnabled}" Margin="0,0,0,20" Height="35"/>

                            <Button Style="{StaticResource PrimaryButton}" Content="{Binding SerialButtonText}" Command="{Binding ToggleSerialCommand}" Height="35"/>
                        </StackPanel>
                    </TabItem>

                    <!-- 网络 Tab -->
                    <TabItem Header="网络">
                        <StackPanel Margin="16,8,16,16">
                            <TextBlock Text="本机IP" Style="{StaticResource DataLabel}"/>
                            <ComboBox ItemsSource="{Binding LocalIPs}" SelectedItem="{Binding SelectedHostIP, Mode=TwoWay}" IsEnabled="{Binding IsNetConfigEnabled}" Margin="0,0,0,16"/>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="网络类型" Style="{StaticResource DataLabel}"/>
                                    <ComboBox ItemsSource="{Binding NetTypes}" SelectedItem="{Binding SelectedNetType, Mode=TwoWay}" IsEnabled="{Binding IsNetConfigEnabled}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="端口" Style="{StaticResource DataLabel}"/>
                                    <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsNetConfigEnabled}" Height="35"/>
                                </StackPanel>
                            </Grid>

                            <Button Style="{StaticResource PrimaryButton}" Content="{Binding ListenButtonText}" Command="{Binding ToggleListenCommand}" Height="40" Margin="0,0,0,20"/>

                            <TextBlock Text="对端" Style="{StaticResource DataLabel}"/>
                            <ComboBox ItemsSource="{Binding PeerList}" SelectedItem="{Binding SelectedPeer, Mode=TwoWay}"/>
                        </StackPanel>
                    </TabItem>

                    <!-- 蓝牙 Tab -->
                    <TabItem Header="蓝牙">
                        <Grid Margin="16,8,16,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- 蓝牙状态栏 -->
                            <Border Grid.Row="0" Background="{StaticResource BgPrimaryBrush}" CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{Binding BthStatusColor}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding BthRadioStatus}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- 服务端/客户端子 Tab -->
                            <TabControl Grid.Row="1">
                                <!-- 服务端 Tab -->
                                <TabItem Header="服务端">
                                    <StackPanel Margin="0,12,0,0">
                                        <Button Style="{StaticResource PrimaryButton}" Content="{Binding BthListenButtonText}" Command="{Binding ToggleBluetoothCommand}" Height="35" Margin="0,0,0,16"/>

                                        <TextBlock Text="已连接设备" Style="{StaticResource DataLabel}"/>
                                        <ComboBox ItemsSource="{Binding BthSlaveList}" SelectedItem="{Binding SelectedBthSlave, Mode=TwoWay}" Margin="0,0,0,16"/>

                                        <ui:SendRow Text="{Binding BthServerSendText, Mode=TwoWay}" SendCommand="{Binding BthServerSendCommand}"/>
                                    </StackPanel>
                                </TabItem>

                                <!-- 客户端 Tab -->
                                <TabItem Header="客户端">
                                    <StackPanel Margin="0,12,0,0">
                                        <Button Content="{Binding BthScanButtonText}" Command="{Binding BthScanCommand}" Height="35" Margin="0,0,0,16"/>

                                        <TextBlock Text="发现的设备" Style="{StaticResource DataLabel}"/>
                                        <ComboBox ItemsSource="{Binding BthDeviceList}" SelectedItem="{Binding SelectedBthDevice, Mode=TwoWay}" Margin="0,0,0,12"/>

                                        <Button Style="{StaticResource SuccessButton}" Content="{Binding BthConnectButtonText}" Command="{Binding BthConnectCommand}" Height="36" Margin="0,0,0,16"/>

                                        <ui:SendRow Text="{Binding BthClientSendText, Mode=TwoWay}" SendCommand="{Binding BthClientSendCommand}"/>
                                    </StackPanel>
                                </TabItem>
                            </TabControl>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- 通用设置卡片 -->
            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="16" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="发送通道" Style="{StaticResource SectionHeader}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <RadioButton Content="Serial" IsChecked="{Binding IsSerialChannel}" Margin="0,0,20,0"/>
                        <RadioButton Content="NET" IsChecked="{Binding IsNetChannel}" Margin="0,0,20,0"/>
                        <RadioButton Content="BT" IsChecked="{Binding IsBtChannel}"/>
                    </StackPanel>

                    <TextBlock Text="数据格式" Style="{StaticResource SectionHeader}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <RadioButton Content="HEX" IsChecked="{Binding IsHexMode}" Margin="0,0,20,0"/>
                        <RadioButton Content="CHAR" IsChecked="{Binding IsCharMode}"/>
                    </StackPanel>

                    <Grid Margin="0,0,0,12" Height="35">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" Content="自动发送" IsChecked="{Binding AutoSendEnabled}" Margin="0,0,12,0"/>
                        <TextBox Grid.Column="1" Text="{Binding AutoSendInterval, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Width="90" Margin="43,0,0,0"/>
                        <TextBlock Grid.Column="2" Text="ms" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal">
                        <CheckBox Content="本地回显" IsChecked="{Binding LocalEcho}" Margin="0,0,20,0"/>
                        <CheckBox Content="数据转存" IsChecked="{Binding SaveDataEnabled}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============================================================
             中间面板: 数据收发
             ============================================================ -->
        <Grid Grid.Column="1" Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <ui:PanelHeader Grid.Row="0" Title="数据收发" DotColor="{StaticResource AccentCyanBrush}"/>

            <!-- 接收区卡片 -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 接收区头部 -->
                    <Border Grid.Row="0" Background="{StaticResource BgSecondaryBrush}" CornerRadius="8,8,0,0" Padding="16,10">
                        <DockPanel LastChildFill="False">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <TextBlock Text="接收区" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentCyanBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Rx" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding RxCount}" Foreground="{StaticResource AccentGreenBrush}" FontSize="14" FontWeight="Bold" FontFamily="{StaticResource FontMono}"/>
                                </StackPanel>
                            </StackPanel>
                            <Button Content="清空" Command="{Binding ClearRecvCommand}" Padding="12,4" FontSize="11" DockPanel.Dock="Right" Width="60"/>
                        </DockPanel>
                    </Border>

                    <!-- 接收内容 -->
                    <Border Grid.Row="1" Background="{StaticResource BgDeepBrush}" Margin="1,0,1,0">
                        <TextBox x:Name="RecvTextBox" Style="{StaticResource MonoTextBox}" Text="{Binding RecvText}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" Padding="16" FontSize="12"/>
                    </Border>

                    <!-- 状态栏 -->
                    <Border Grid.Row="2" Background="{StaticResource BgSecondaryBrush}" CornerRadius="0,0,8,8" Padding="16,8">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource AccentGreenBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding MemUsage}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontFamily="{StaticResource FontMono}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,16,0"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Tx" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding TxCount, Mode=OneWay}" Foreground="{StaticResource AccentBlueBrush}" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource FontMono}"/>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 发送区卡片 -->
            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Style="{StaticResource MonoTextBox}" Text="{Binding SendText}" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0" FontSize="12"/>
                    <StackPanel Grid.Column="1" Width="80">
                        <Button Style="{StaticResource PrimaryButton}" Content="发送" Command="{Binding SendCommand}" Height="32" Margin="0,0,0,8" Padding="8,2"/>
                        <Button Content="{Binding AutoSendButtonText}" Command="{Binding ToggleAutoSendCommand}" Height="32" Margin="0,0,0,8" Padding="8,2"/>
                        <Button Content="清空" Command="{Binding ClearSendCommand}" Height="32" Padding="8,2"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 通信监控卡片：流量曲线 + 通道状态 -->
            <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,12,0,0" Padding="12,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="通信监控" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>

                    <ui:TrafficChart x:Name="TrafficChartControl" Grid.Row="1" Margin="0,0,0,6"/>

                    <ui:ChannelStatusIndicator x:Name="ChannelStatusControl" Grid.Row="2" States="{Binding ChannelStates}"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================================================
             右侧面板: 控制与监控
             ============================================================ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <ui:PanelHeader Grid.Row="0" Title="运动控制" DotColor="{StaticResource AccentOrangeBrush}"/>

            <!-- 控制卡片 -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0">
                <TabControl>
                    <!-- 运动控制 Tab -->
                    <TabItem Header="运动控制">
                        <Grid Margin="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- 数值显示 -->
                            <Grid Grid.Row="0" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ui:MetricItem Grid.Column="0" Label="速度" Value="{Binding FbValue}" ValueFontSize="24"/>
                                <ui:MetricItem Grid.Column="1" Label="方向" Value="{Binding RlValue}" ValueFontSize="24"/>
                            </Grid>

                            <!-- 虚拟摇杆 -->
                            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ui:JoystickControl Speed="{Binding FbValue, Mode=TwoWay}" Direction="{Binding RlValue, Mode=TwoWay}"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <!-- 批量字串 Tab -->
                    <TabItem Header="批量字串">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="16">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="HEX" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="待发送字串" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="8,0"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding PresetMessages}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="60"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsHex}" VerticalAlignment="Center" Margin="0,0,8,0" Height="35"/>
                                                <TextBox Grid.Column="1" Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" FontSize="12" Height="35"/>
                                                <Button Grid.Column="2" Content="发送" Command="{Binding SendCommand}" FontSize="11" Height="35"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- 行走路线 Tab -->
                    <TabItem Header="行走路线">
                        <Grid Margin="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border x:Name="MapBorder" Grid.Row="0" Background="{StaticResource BgDeepBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True" Margin="0,0,0,12"
                                    SizeChanged="MapCanvas_SizeChanged">
                                <Canvas x:Name="MapCanvas" Background="Transparent"
                                        MouseLeftButtonDown="MapCanvas_MouseLeftButtonDown" MouseMove="MapCanvas_MouseMove"/>
                            </Border>

                            <Grid Grid.Row="1" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="打开" Command="{Binding OpenMapCommand}" Margin="0,0,8,0" Padding="12,4"/>
                                <Button Grid.Column="1" Content="清除锚点" Command="{Binding ClearMapCommand}" Margin="0,0,16,0" Padding="12,4"/>
                                <ui:MetricLabel Grid.Column="2" Label="起点" Value="{Binding MapStartPoint}" Margin="0,0,12,0"/>
                                <ui:MetricLabel Grid.Column="3" Label="终点" Value="{Binding MapEndPoint}"/>
                            </Grid>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ui:MetricLabel Grid.Column="0" Label="鼠标" Value="{Binding MousePosition}" Margin="0,0,16,0"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="距离(m)" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBox Text="{Binding CalibratedDistance, UpdateSourceTrigger=PropertyChanged}" Width="80" FontSize="11" VerticalAlignment="Center" TextAlignment="Center" Height="35"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- 姿态监控卡片 -->
            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,12,0,0" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="姿态监控" Style="{StaticResource SectionHeader}" Margin="0,0,0,12"/>

                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <ui:CompassGauge Angle="{Binding Yaw}"/>
                            <TextBlock Text="偏航" Style="{StaticResource DataLabel}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <ui:RollGauge Angle="{Binding Roll}"/>
                            <TextBlock Text="横滚" Style="{StaticResource DataLabel}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <ui:PitchGauge Angle="{Binding Pitch}"/>
                            <TextBlock Text="俯仰" Style="{StaticResource DataLabel}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <ui:DistanceGauge Distance="{Binding Distance}"/>
                            <TextBlock Text="航程" Style="{StaticResource DataLabel}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" Content="角度显示" IsChecked="{Binding AngleDisplayEnabled}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="清除" Command="{Binding ClearAttitudeCommand}" HorizontalAlignment="Right" Padding="16,4" FontSize="11"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
