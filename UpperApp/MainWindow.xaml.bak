<Window x:Class="UpperApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:UpperApp.ViewModels"
        Title="小车上位机V7.0" Height="700" Width="1400"
        MinWidth="1024" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgPrimaryBrush}">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" MinWidth="220"/>
            <ColumnDefinition Width="*" MinWidth="350"/>
            <ColumnDefinition Width="420" MinWidth="350"/>
        </Grid.ColumnDefinitions>

        <!-- ===== LEFT PANEL: Connection Config ===== -->
        <Grid Grid.Column="0" Margin="0,0,2,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TabControl Grid.Row="0" Margin="4">
                <!-- Serial Tab -->
                <TabItem Header="串口">
                    <StackPanel Margin="8">
                        <Label Content="端口"/>
                        <ComboBox ItemsSource="{Binding SerialPorts}" SelectedItem="{Binding SelectedSerialPort, Mode=TwoWay}" IsEnabled="{Binding IsSerialConfigEnabled}" Margin="0,0,0,8"/>
                        <Label Content="波特率"/>
                        <ComboBox ItemsSource="{Binding BaudRates}" SelectedItem="{Binding SelectedBaudRate, Mode=TwoWay}" IsEditable="True" IsEnabled="{Binding IsSerialConfigEnabled}" Margin="0,0,0,12"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="{Binding SerialButtonText}" Command="{Binding ToggleSerialCommand}"/>
                    </StackPanel>
                </TabItem>

                <!-- Network Tab -->
                <TabItem Header="网络">
                    <StackPanel Margin="8">
                        <Label Content="本机IP"/>
                        <ComboBox ItemsSource="{Binding LocalIPs}" SelectedItem="{Binding SelectedHostIP, Mode=TwoWay}" IsEnabled="{Binding IsNetConfigEnabled}" Margin="0,0,0,8"/>
                        <DockPanel Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <Label Content="网络类型" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox Width="70" ItemsSource="{Binding NetTypes}" SelectedItem="{Binding SelectedNetType, Mode=TwoWay}" IsEnabled="{Binding IsNetConfigEnabled}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <Label Content="端口" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Width="60" IsEnabled="{Binding IsNetConfigEnabled}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>
                        <Button Style="{StaticResource PrimaryButton}" Content="{Binding ListenButtonText}" Command="{Binding ToggleListenCommand}" Margin="0,0,0,12"/>
                        <Label Content="对端"/>
                        <ComboBox ItemsSource="{Binding PeerList}" SelectedItem="{Binding SelectedPeer, Mode=TwoWay}"/>
                    </StackPanel>
                </TabItem>

                <!-- Bluetooth Tab -->
                <TabItem Header="蓝牙">
                    <StackPanel Margin="8">
                        <Button Style="{StaticResource PrimaryButton}" Content="{Binding BthListenButtonText}" Command="{Binding ToggleBluetoothCommand}" Margin="0,0,0,8"/>
                        <TextBox Style="{StaticResource MonoTextBox}" Text="{Binding BthRecvText}" IsReadOnly="True" Height="100" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8"/>
                        <DockPanel Margin="0,0,0,8">
                            <Button Content="发送" Command="{Binding BthSendCommand}" DockPanel.Dock="Right" Width="60"/>
                            <TextBox Text="{Binding BthSendText, UpdateSourceTrigger=PropertyChanged}" DockPanel.Dock="Left"/>
                        </DockPanel>
                        <Button Content="{Binding BthScanButtonText}" Command="{Binding BthScanCommand}" Margin="0,0,0,8"/>
                        <Label Content="主设备"/>
                        <ComboBox ItemsSource="{Binding BthDeviceList}" SelectedItem="{Binding SelectedBthDevice, Mode=TwoWay}" Margin="0,0,0,8"/>
                        <Label Content="从设备"/>
                        <ComboBox ItemsSource="{Binding BthSlaveList}" SelectedItem="{Binding SelectedBthSlave, Mode=TwoWay}" Margin="0,0,0,8"/>
                        <Button Content="{Binding BthConnectButtonText}" Command="{Binding BthConnectCommand}"/>
                    </StackPanel>
                </TabItem>
            </TabControl>

            <!-- Common Settings -->
            <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="8,6">
                <StackPanel>
                    <Label Content="发送通道" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <RadioButton Content="Serial" IsChecked="{Binding IsSerialChannel}" Margin="0,0,12,0"/>
                        <RadioButton Content="NET" IsChecked="{Binding IsNetChannel}" Margin="0,0,12,0"/>
                        <RadioButton Content="BT" IsChecked="{Binding IsBtChannel}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <RadioButton Content="HEX" IsChecked="{Binding IsHexMode}" Margin="0,0,12,0"/>
                        <RadioButton Content="CHAR" IsChecked="{Binding IsCharMode}"/>
                    </StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <CheckBox Content="自动发送" IsChecked="{Binding AutoSendEnabled}" DockPanel.Dock="Left"/>
                        <TextBox Text="{Binding AutoSendInterval, UpdateSourceTrigger=PropertyChanged}" Width="50" DockPanel.Dock="Right"/>
                        <Label Content="ms" DockPanel.Dock="Right"/>
                    </DockPanel>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox Content="本地回显" IsChecked="{Binding LocalEcho}" Margin="0,0,12,0"/>
                        <CheckBox Content="数据转存" IsChecked="{Binding SaveDataEnabled}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== CENTER PANEL: Data Area ===== -->
        <Grid Grid.Column="1" Margin="2,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Recv Header -->
            <DockPanel Grid.Row="0" Margin="4,4,4,0" Background="{StaticResource BgSecondaryBrush}">
                <Button Content="清空" Command="{Binding ClearRecvCommand}" DockPanel.Dock="Right" Padding="8,2" FontSize="10"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="接收区" Foreground="{StaticResource AccentBlueBrush}" VerticalAlignment="Center" Margin="6,0,12,0" FontSize="12"/>
                    <TextBlock Text="Rx:" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" FontSize="10"/>
                    <TextBlock Text="{Binding RxCount}" Foreground="{StaticResource AccentGreenBrush}" VerticalAlignment="Center" Margin="4,0,0,0" FontSize="10"/>
                </StackPanel>
            </DockPanel>

            <!-- RecvBox -->
            <TextBox Grid.Row="1" Style="{StaticResource MonoTextBox}" Text="{Binding RecvText}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="4,0,4,0"/>

            <!-- Status Bar -->
            <DockPanel Grid.Row="2" Margin="4,0" Background="{StaticResource BgTertiaryBrush}" Height="22">
                <TextBlock Text="{Binding MemUsage}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" DockPanel.Dock="Right" Margin="8,0,4,0" FontSize="10"/>
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="10"/>
                <TextBlock Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="10">
                    <Run Text="Tx:"/><Run Text="{Binding TxCount, Mode=OneWay}"/>
                </TextBlock>
            </DockPanel>

            <!-- Send Area -->
            <Grid Grid.Row="3" Margin="4,4,4,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Style="{StaticResource MonoTextBox}" Text="{Binding SendText}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,4,0"/>
                <StackPanel Grid.Column="1" Width="70">
                    <Button Style="{StaticResource PrimaryButton}" Content="发送" Command="{Binding SendCommand}" Margin="0,0,0,4"/>
                    <Button Content="{Binding AutoSendButtonText}" Command="{Binding ToggleAutoSendCommand}" Margin="0,0,0,4"/>
                    <Button Content="清空" Command="{Binding ClearSendCommand}" FontSize="10"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ===== RIGHT PANEL: Control ===== -->
        <Grid Grid.Column="2" Margin="2,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TabControl Grid.Row="0" Margin="4">
                <!-- Motion Control Tab -->
                <TabItem Header="运动控制">
                    <GroupBox Header="运动控制" Margin="4">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                                <Label Content="速度" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <Slider Value="{Binding FbValue}" Minimum="0" Maximum="100" Width="180" VerticalAlignment="Center" SmallChange="{Binding StepSize}"/>
                                <TextBlock Text="{Binding FbValue}" Width="30" VerticalAlignment="Center" TextAlignment="Center" Foreground="{StaticResource AccentCyanBrush}" FontWeight="Bold" FontFamily="Consolas"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                                <Label Content="方向" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <Slider Value="{Binding RlValue}" Minimum="0" Maximum="100" Width="180" VerticalAlignment="Center" SmallChange="{Binding StepSize}"/>
                                <TextBlock Text="{Binding RlValue}" Width="30" VerticalAlignment="Center" TextAlignment="Center" Foreground="{StaticResource AccentCyanBrush}" FontWeight="Bold" FontFamily="Consolas"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                                <Label Content="步进:" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding StepSize, UpdateSourceTrigger=PropertyChanged}" Width="40" Margin="4,0,12,0"/>
                                <Button Content="停车" Command="{Binding StopCommand}" Width="55" Margin="0,0,6,0"/>
                                <Button Content="回正" Command="{Binding ResetDirectionCommand}" Width="55"/>
                            </StackPanel>

                            <Separator Grid.Row="3" Margin="0,4"/>

                            <Button Grid.Row="4" Content="{Binding RockerText}" Command="{Binding ToggleRockerCommand}" 
                                    FontSize="16" FontWeight="Bold" Margin="4"
                                    Foreground="{StaticResource AccentCyanBrush}"/>
                        </Grid>
                    </GroupBox>
                </TabItem>

                <!-- Batch Messages Tab -->
                <TabItem Header="批量字串">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="4">
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="HEX" Foreground="{StaticResource TextMutedBrush}" Width="30" VerticalAlignment="Center"/>
                                <TextBlock Text="待发送字串" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="4,0"/>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding PresetMessages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,2">
                                            <Button Content="发送" Command="{Binding SendCommand}" Width="50" DockPanel.Dock="Right" FontSize="10"/>
                                            <CheckBox IsChecked="{Binding IsHex}" DockPanel.Dock="Left" Margin="0,0,4,0"/>
                                            <TextBox Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}" Margin="4,0"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Map Tab -->
                <TabItem Header="行走路线">
                    <Grid Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border x:Name="MapBorder" Grid.Row="0" Background="{StaticResource BgPrimaryBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ClipToBounds="True" Margin="0,0,0,4"
                                SizeChanged="MapCanvas_SizeChanged">
                            <Canvas x:Name="MapCanvas" Background="Transparent"
                                    MouseLeftButtonDown="MapCanvas_MouseLeftButtonDown" MouseMove="MapCanvas_MouseMove"/>
                        </Border>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,2">
                            <Button Content="打开" Command="{Binding OpenMapCommand}" Margin="0,0,4,0"/>
                            <Button Content="清除锚点" Command="{Binding ClearMapCommand}" Margin="0,0,8,0"/>
                            <TextBlock Text="起点:" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" FontSize="10" Margin="0,0,2,0"/>
                            <TextBlock Text="{Binding MapStartPoint}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="终点:" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" FontSize="10" Margin="0,0,2,0"/>
                            <TextBlock Text="{Binding MapEndPoint}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="鼠标:" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" FontSize="10" Margin="0,0,2,0"/>
                            <TextBlock Text="{Binding MousePosition}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="距离(m):" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" FontSize="10" Margin="0,0,2,0"/>
                            <TextBox Text="{Binding CalibratedDistance, UpdateSourceTrigger=PropertyChanged}" Width="50" FontSize="10" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- 姿态栏 -->
            <GroupBox Header="姿态" Grid.Row="1" Margin="4,2,4,4">
                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="偏航" Grid.Row="0" Grid.Column="0" Foreground="{StaticResource TextMutedBrush}" FontSize="10" HorizontalAlignment="Center"/>
                    <TextBlock Text="横滚" Grid.Row="0" Grid.Column="1" Foreground="{StaticResource TextMutedBrush}" FontSize="10" HorizontalAlignment="Center"/>
                    <TextBlock Text="俯仰" Grid.Row="0" Grid.Column="2" Foreground="{StaticResource TextMutedBrush}" FontSize="10" HorizontalAlignment="Center"/>
                    <TextBlock Text="航程" Grid.Row="0" Grid.Column="3" Foreground="{StaticResource TextMutedBrush}" FontSize="10" HorizontalAlignment="Center"/>

                    <TextBlock Text="{Binding Yaw}" Grid.Row="1" Grid.Column="0" Foreground="{StaticResource AccentOrangeBrush}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" FontFamily="Consolas"/>
                    <TextBlock Text="{Binding Roll}" Grid.Row="1" Grid.Column="1" Foreground="{StaticResource AccentOrangeBrush}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" FontFamily="Consolas"/>
                    <TextBlock Text="{Binding Pitch}" Grid.Row="1" Grid.Column="2" Foreground="{StaticResource AccentOrangeBrush}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" FontFamily="Consolas"/>
                    <TextBlock Text="{Binding Distance}" Grid.Row="1" Grid.Column="3" Foreground="{StaticResource AccentOrangeBrush}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" FontFamily="Consolas"/>

                    <CheckBox Content="角度显示" IsChecked="{Binding AngleDisplayEnabled}" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4,0,0"/>
                    <Button Content="清除" Command="{Binding ClearAttitudeCommand}" Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" FontSize="10" Padding="8,2" Margin="0,4,0,0"/>
                </Grid>
            </GroupBox>
        </Grid>
    </Grid>
</Window>
