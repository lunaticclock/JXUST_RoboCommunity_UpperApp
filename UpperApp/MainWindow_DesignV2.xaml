<Window x:Class="UpperApp.MainWindowDesignV2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:UpperApp.ViewModels"
        Title="小车上位机 V7.0" Height="800" Width="1500"
        MinWidth="1200" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDeepBrush}">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- 引入新主题 -->
        <ResourceDictionary Source="Themes/DarkThemeV2.xaml"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" MinWidth="260"/>
            <ColumnDefinition Width="*" MinWidth="400"/>
            <ColumnDefinition Width="400" MinWidth="360"/>
        </Grid.ColumnDefinitions>

        <!-- ============================================================
             左侧面板: 连接配置
             ============================================================ -->
        <Grid Grid.Column="0" Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                <Ellipse Width="10" Height="10" Fill="{StaticResource AccentBlueBrush}" Margin="0,0,10,0" VerticalAlignment="Center">
                    <Ellipse.Effect>
                        <DropShadowEffect Color="{StaticResource AccentBlueGlow}" ShadowDepth="0" BlurRadius="8" Opacity="0.6"/>
                    </Ellipse.Effect>
                </Ellipse>
                <TextBlock Text="连接配置" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
            </StackPanel>

            <!-- 连接卡片 -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                <TabControl>
                    <!-- 串口 Tab -->
                    <TabItem Header="串口">
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Text="端口" Style="{StaticResource DataLabel}"/>
                            <ComboBox ItemsSource="{Binding SerialPorts}" SelectedItem="{Binding SelectedSerialPort, Mode=TwoWay}" IsEnabled="{Binding IsSerialConfigEnabled}" Margin="0,0,0,16"/>

                            <TextBlock Text="波特率" Style="{StaticResource DataLabel}"/>
                            <ComboBox ItemsSource="{Binding BaudRates}" SelectedItem="{Binding SelectedBaudRate, Mode=TwoWay}" IsEditable="True" IsEnabled="{Binding IsSerialConfigEnabled}" Margin="0,0,0,20"/>

                            <Button Style="{StaticResource PrimaryButton}" Content="{Binding SerialButtonText}" Command="{Binding ToggleSerialCommand}" Height="40"/>
                        </StackPanel>
                    </TabItem>

                    <!-- 网络 Tab -->
                    <TabItem Header="网络">
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Text="本机IP" Style="{StaticResource DataLabel}"/>
                            <ComboBox ItemsSource="{Binding LocalIPs}" SelectedItem="{Binding SelectedHostIP, Mode=TwoWay}" IsEnabled="{Binding IsNetConfigEnabled}" Margin="0,0,0,16"/>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="网络类型" Style="{StaticResource DataLabel}"/>
                                    <ComboBox ItemsSource="{Binding NetTypes}" SelectedItem="{Binding SelectedNetType, Mode=TwoWay}" IsEnabled="{Binding IsNetConfigEnabled}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="端口" Style="{StaticResource DataLabel}"/>
                                    <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsNetConfigEnabled}"/>
                                </StackPanel>
                            </Grid>

                            <Button Style="{StaticResource PrimaryButton}" Content="{Binding ListenButtonText}" Command="{Binding ToggleListenCommand}" Height="40" Margin="0,0,0,20"/>

                            <TextBlock Text="对端" Style="{StaticResource DataLabel}"/>
                            <ComboBox ItemsSource="{Binding PeerList}" SelectedItem="{Binding SelectedPeer, Mode=TwoWay}"/>
                        </StackPanel>
                    </TabItem>

                    <!-- 蓝牙 Tab -->
                    <TabItem Header="蓝牙">
                        <StackPanel Margin="0,8,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Content="{Binding BthListenButtonText}" Command="{Binding ToggleBluetoothCommand}" Height="40" Margin="0,0,0,16"/>

                            <Border Background="{StaticResource BgPrimaryBrush}" CornerRadius="6" Padding="10" Margin="0,0,0,16">
                                <TextBox Style="{StaticResource MonoTextBox}" Text="{Binding BthRecvText}" IsReadOnly="True" Height="80" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" Padding="0"/>
                            </Border>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding BthSendText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                                <Button Grid.Column="1" Content="发送" Command="{Binding BthSendCommand}" Width="60"/>
                            </Grid>

                            <Button Content="{Binding BthScanButtonText}" Command="{Binding BthScanCommand}" Margin="0,0,0,16"/>

                            <TextBlock Text="主设备" Style="{StaticResource DataLabel}"/>
                            <ComboBox ItemsSource="{Binding BthDeviceList}" SelectedItem="{Binding SelectedBthDevice, Mode=TwoWay}" Margin="0,0,0,12"/>

                            <TextBlock Text="从设备" Style="{StaticResource DataLabel}"/>
                            <ComboBox ItemsSource="{Binding BthSlaveList}" SelectedItem="{Binding SelectedBthSlave, Mode=TwoWay}" Margin="0,0,0,12"/>

                            <Button Style="{StaticResource SuccessButton}" Content="{Binding BthConnectButtonText}" Command="{Binding BthConnectCommand}" Height="36"/>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- 通用设置卡片 -->
            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="16">
                <StackPanel>
                    <TextBlock Text="发送通道" Style="{StaticResource SectionHeader}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <RadioButton Content="Serial" IsChecked="{Binding IsSerialChannel}" Margin="0,0,20,0"/>
                        <RadioButton Content="NET" IsChecked="{Binding IsNetChannel}" Margin="0,0,20,0"/>
                        <RadioButton Content="BT" IsChecked="{Binding IsBtChannel}"/>
                    </StackPanel>

                    <TextBlock Text="数据格式" Style="{StaticResource SectionHeader}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <RadioButton Content="HEX" IsChecked="{Binding IsHexMode}" Margin="0,0,20,0"/>
                        <RadioButton Content="CHAR" IsChecked="{Binding IsCharMode}"/>
                    </StackPanel>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" Content="自动发送" IsChecked="{Binding AutoSendEnabled}" Margin="0,0,12,0"/>
                        <TextBox Grid.Column="1" Text="{Binding AutoSendInterval, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Right" Width="60"/>
                        <TextBlock Grid.Column="2" Text="ms" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal">
                        <CheckBox Content="本地回显" IsChecked="{Binding LocalEcho}" Margin="0,0,20,0"/>
                        <CheckBox Content="数据转存" IsChecked="{Binding SaveDataEnabled}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============================================================
             中间面板: 数据收发
             ============================================================ -->
        <Grid Grid.Column="1" Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                <Ellipse Width="10" Height="10" Fill="{StaticResource AccentCyanBrush}" Margin="0,0,10,0" VerticalAlignment="Center">
                    <Ellipse.Effect>
                        <DropShadowEffect Color="{StaticResource AccentCyan}" ShadowDepth="0" BlurRadius="8" Opacity="0.6"/>
                    </Ellipse.Effect>
                </Ellipse>
                <TextBlock Text="数据收发" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
            </StackPanel>

            <!-- 接收区卡片 -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 接收区头部 -->
                    <Border Grid.Row="0" Background="{StaticResource BgSecondaryBrush}" CornerRadius="8,8,0,0" Padding="16,10">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <TextBlock Text="接收区" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentCyanBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Rx" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding RxCount}" Foreground="{StaticResource AccentGreenBrush}" FontSize="14" FontWeight="Bold" FontFamily="{StaticResource FontMono}"/>
                                </StackPanel>
                            </StackPanel>
                            <Button Content="清空" Command="{Binding ClearRecvCommand}" DockPanel.Dock="Right" Padding="12,4" FontSize="11"/>
                        </DockPanel>
                    </Border>

                    <!-- 接收内容 -->
                    <Border Grid.Row="1" Background="{StaticResource BgDeepBrush}" Margin="1,0,1,0">
                        <TextBox Style="{StaticResource MonoTextBox}" Text="{Binding RecvText}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" Padding="16" FontSize="12"/>
                    </Border>

                    <!-- 状态栏 -->
                    <Border Grid.Row="2" Background="{StaticResource BgSecondaryBrush}" CornerRadius="0,0,8,8" Padding="16,8">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource StatusOnlineBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding MemUsage}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontFamily="{StaticResource FontMono}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,16,0"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Tx" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding TxCount, Mode=OneWay}" Foreground="{StaticResource AccentBlueBrush}" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource FontMono}"/>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 发送区卡片 -->
            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Style="{StaticResource MonoTextBox}" Text="{Binding SendText}" Height="70" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0" FontSize="12"/>
                    <StackPanel Grid.Column="1" Width="80">
                        <Button Style="{StaticResource PrimaryButton}" Content="发送" Command="{Binding SendCommand}" Height="32" Margin="0,0,0,8"/>
                        <Button Content="{Binding AutoSendButtonText}" Command="{Binding ToggleAutoSendCommand}" Height="28" Margin="0,0,0,8" FontSize="11"/>
                        <Button Content="清空" Command="{Binding ClearSendCommand}" Height="24" FontSize="11" Padding="8,2"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================================================
             右侧面板: 控制与监控
             ============================================================ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                <Ellipse Width="10" Height="10" Fill="{StaticResource AccentOrangeBrush}" Margin="0,0,10,0" VerticalAlignment="Center">
                    <Ellipse.Effect>
                        <DropShadowEffect Color="{StaticResource AccentOrange}" ShadowDepth="0" BlurRadius="8" Opacity="0.6"/>
                    </Ellipse.Effect>
                </Ellipse>
                <TextBlock Text="运动控制" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
            </StackPanel>

            <!-- 控制卡片 -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0">
                <TabControl>
                    <!-- 运动控制 Tab -->
                    <TabItem Header="运动控制">
                        <Grid Margin="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- 速度控制 -->
                            <Grid Grid.Row="0" Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="速度" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                                <Slider Grid.Column="1" Value="{Binding FbValue}" Minimum="0" Maximum="100" VerticalAlignment="Center" Margin="8,0"/>
                                <TextBlock Grid.Column="2" Text="{Binding FbValue}" TextAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource AccentCyanBrush}" FontWeight="Bold" FontFamily="{StaticResource FontMono}" FontSize="16"/>
                            </Grid>

                            <!-- 方向控制 -->
                            <Grid Grid.Row="1" Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="方向" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                                <Slider Grid.Column="1" Value="{Binding RlValue}" Minimum="0" Maximum="100" VerticalAlignment="Center" Margin="8,0"/>
                                <TextBlock Grid.Column="2" Text="{Binding RlValue}" TextAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource AccentCyanBrush}" FontWeight="Bold" FontFamily="{StaticResource FontMono}" FontSize="16"/>
                            </Grid>

                            <!-- 步进与控制 -->
                            <Grid Grid.Row="2" Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="步进" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,12,0"/>
                                <TextBox Grid.Column="1" Text="{Binding StepSize, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" TextAlignment="Center"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource DangerButton}" Content="停车" Command="{Binding StopCommand}" Width="70" Height="32" Margin="0,0,8,0"/>
                                    <Button Content="回正" Command="{Binding ResetDirectionCommand}" Width="70" Height="32"/>
                                </StackPanel>
                            </Grid>

                            <Separator Grid.Row="3"/>

                            <!-- 摇杆按钮 -->
                            <Button Grid.Row="4" Content="{Binding RockerText}" Command="{Binding ToggleRockerCommand}" 
                                    Height="60" Margin="0,8,0,0"
                                    FontSize="18" FontWeight="Bold"
                                    Foreground="{StaticResource AccentCyanBrush}"
                                    Background="{StaticResource BgPrimaryBrush}"
                                    BorderBrush="{StaticResource AccentCyanBrush}"
                                    BorderThickness="2">
                                <Button.Effect>
                                    <DropShadowEffect Color="{StaticResource AccentCyan}" ShadowDepth="0" BlurRadius="12" Opacity="0.3"/>
                                </Button.Effect>
                            </Button>
                        </Grid>
                    </TabItem>

                    <!-- 批量字串 Tab -->
                    <TabItem Header="批量字串">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="16">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="HEX" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="待发送字串" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="8,0"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding PresetMessages}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="60"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsHex}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBox Grid.Column="1" Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" FontSize="12"/>
                                                <Button Grid.Column="2" Content="发送" Command="{Binding SendCommand}" FontSize="11" Height="28"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- 行走路线 Tab -->
                    <TabItem Header="行走路线">
                        <Grid Margin="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border x:Name="MapBorder" Grid.Row="0" Background="{StaticResource BgDeepBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True" Margin="0,0,0,12"
                                    SizeChanged="MapCanvas_SizeChanged">
                                <Canvas x:Name="MapCanvas" Background="Transparent"
                                        MouseLeftButtonDown="MapCanvas_MouseLeftButtonDown" MouseMove="MapCanvas_MouseMove"/>
                            </Border>

                            <Grid Grid.Row="1" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="打开" Command="{Binding OpenMapCommand}" Margin="0,0,8,0" Padding="12,4"/>
                                <Button Grid.Column="1" Content="清除锚点" Command="{Binding ClearMapCommand}" Margin="0,0,16,0" Padding="12,4"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,12,0">
                                    <TextBlock Text="起点" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding MapStartPoint}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontFamily="{StaticResource FontMono}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Orientation="Horizontal">
                                    <TextBlock Text="终点" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding MapEndPoint}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontFamily="{StaticResource FontMono}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,16,0">
                                    <TextBlock Text="鼠标" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding MousePosition}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontFamily="{StaticResource FontMono}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="距离(m)" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBox Text="{Binding CalibratedDistance, UpdateSourceTrigger=PropertyChanged}" Width="60" FontSize="11" VerticalAlignment="Center" TextAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- 姿态监控卡片 -->
            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,12,0,0" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="姿态监控" Style="{StaticResource SectionHeader}" Margin="0,0,0,12"/>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 偏航 -->
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="偏航" Style="{StaticResource DataLabel}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Yaw}" Style="{StaticResource DataValue}" FontSize="18"/>
                        </StackPanel>

                        <!-- 横滚 -->
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="横滚" Style="{StaticResource DataLabel}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Roll}" Style="{StaticResource DataValue}" FontSize="18"/>
                        </StackPanel>

                        <!-- 俯仰 -->
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock Text="俯仰" Style="{StaticResource DataLabel}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Pitch}" Style="{StaticResource DataValue}" FontSize="18"/>
                        </StackPanel>

                        <!-- 航程 -->
                        <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                            <TextBlock Text="航程" Style="{StaticResource DataLabel}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Distance}" Style="{StaticResource DataValue}" FontSize="18"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,60,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" Content="角度显示" IsChecked="{Binding AngleDisplayEnabled}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="清除" Command="{Binding ClearAttitudeCommand}" HorizontalAlignment="Right" Padding="16,4" FontSize="11"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
