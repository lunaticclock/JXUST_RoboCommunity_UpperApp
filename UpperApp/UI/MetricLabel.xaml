<UserControl x:Class="UpperApp.UI.MetricLabel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Orientation="Horizontal">
        <TextBlock Text="{Binding Label, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                   VerticalAlignment="Center" Margin="0,0,4,0"/>
        <TextBlock Text="{Binding Value, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                   FontFamily="{DynamicResource FontMono}" VerticalAlignment="Center"/>
    </StackPanel>
</UserControl>
