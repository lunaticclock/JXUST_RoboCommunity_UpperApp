<UserControl x:Class="UpperApp.UI.PanelHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
        <Ellipse Width="10" Height="10"
                 Fill="{Binding DotColor, RelativeSource={RelativeSource AncestorType=UserControl}}"
                 Margin="0,0,10,0" VerticalAlignment="Center">
            <Ellipse.Effect>
                <DropShadowEffect Color="{Binding DotColor.Color, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  ShadowDepth="0" BlurRadius="8" Opacity="0.6"/>
            </Ellipse.Effect>
        </Ellipse>
        <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   FontSize="16" FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimaryBrush}"/>
    </StackPanel>
</UserControl>
